# Copy to .env (same folder you run goldib from) and fill in.
# These are the same variables GoldCatcher (session-bias-pro) uses, so you can
# copy your existing GoldCatcher .env file next to goldib unchanged.
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-from-BotFather
TELEGRAM_CHAT_ID=-1001234567890
# Optional, only for symbols that need a TradingView login:
# TV_AUTH_TOKEN=
