//@version=6
// =============================================================================
//  Gold Secret Inside-Bar & Fakeout Wick Strategy [1:2 / 1:3 RR]
//  ---------------------------------------------------------------------------
//  Open-source Pine Script® v6 strategy. No external libraries.
//
//  8-STEP WORKFLOW
//    1. 🔥 LEVEL MARK   – candidate Support / Resistance swing where a liquidity
//                         sweep / fakeout wick forms.
//    2. 📊 INSIDE BAR   – Inside Bar (high <= high[1], low >= low[1]) at / next
//                         to the swing.  bar[1] = Mother Bar, bar[0] = Inside Bar.
//    3. ⬆️⬇️ BREAK      – price breaks the Mother Bar AWAY from the level and
//                         impulses at least N × zone height → zone VERIFIED.
//    4. 🔁 RETEST       – price pulls back INTO the verified box for the FIRST time.
//    5. ✅ CONFIRMATION – rejection candle inside / at the box.
//    6. 🎯 ENTRY        – Long at Support / Short at Resistance. ONE trade per zone.
//    7. 🛑 SMALL SL     – just beyond the outer boundary of the box (+ buffer).
//    8. 💰 1:2 BOOK / 1:3 FINAL – partial close at 1:2 RR (optional breakeven),
//                         remainder closed at 1:3 RR (configurable up to 1:5).
// =============================================================================
strategy(title                   = "Gold Secret Inside-Bar & Fakeout Wick Strategy [1:2 / 1:3 RR]",
         shorttitle              = "Gold IB Fakeout [1:2 / 1:3]",
         overlay                 = true,
         max_boxes_count         = 500,
         max_lines_count         = 500,
         max_labels_count        = 500,
         default_qty_type        = strategy.percent_of_equity,
         default_qty_value       = 10,
         initial_capital         = 1000,
         pyramiding              = 0,
         margin_long             = 0.5,
         margin_short            = 0.5,
         process_orders_on_close = true)

// =============================================================================
//  CONSTANTS
// =============================================================================
ST_PENDING     = 0   // candidate formed, waiting for Mother-Bar break
ST_BROKEN      = 1   // Mother Bar broken, waiting for impulse away
ST_VERIFIED    = 2   // verified, active, waiting for first retest
ST_TRADED      = 3   // traded once (is_used)
ST_CONSUMED    = 4   // first retest happened but no trade taken (is_used)
ST_INVALIDATED = 5   // close beyond the opposite side of the box
ST_EXPIRED     = 6   // too old

KIND_SUPPORT    =  1
KIND_RESISTANCE = -1

MODE_LOCAL = "Local Fakeout Wick / Inside Bar Zone"
MODE_DAILY = "Daily Reference Wick Size (Locked Daily Height)"

// =============================================================================
//  INPUTS
// =============================================================================
G_SETUP = "1) Inside Bar & Fakeout Detection"
G_ZONE  = "2) Zone Sizing"
G_BREAK = "3) Breakout Verification"
G_RET   = "4) Retest & Confirmation"
G_RISK  = "5) Risk: SL / TP1 / TP2"
G_FILT  = "6) Filters"
G_VIS   = "7) Visuals"
G_DASH  = "8) Checklist Dashboard"

ib_tol_ticks   = input.int(0, "Inside Bar tolerance (ticks)", minval = 0, group = G_SETUP,
     tooltip = "Allows the Inside Bar to exceed the Mother Bar by this many ticks.")
ib_tol_atr     = input.float(0.02, "Inside Bar tolerance (× ATR)", minval = 0.0, maxval = 0.2, step = 0.01, group = G_SETUP,
     tooltip = "Extra tolerance scaled by ATR so cent-level wick differences between broker feeds do not flip the Inside Bar test. Backtest: 0.02 raised PF and cross-feed consistency.")
ib_color_mode  = input.string("Any Color", "Require Colored Inside Bar",
     options = ["Any Color", "Colored (Red @ Resistance / Green @ Support)"], group = G_SETUP)
swing_lookback = input.int(30, "Swing lookback (bars)", minval = 3, group = G_SETUP,
     tooltip = "Lookback used for ta.highest / ta.lowest swing detection and prior swing sweeps.")
ctx_bars       = input.int(3, "Swing context window (Mother Bar + preceding bars)", minval = 1, maxval = 3, group = G_SETUP,
     tooltip = "The swing / fakeout wick may be the Mother Bar or up to 2 bars immediately preceding the Inside Bar.")
sweep_wick_pct = input.float(0.40, "Sweep rejection wick ≥ % of candle range", minval = 0.0, maxval = 1.0, step = 0.05, group = G_SETUP)
level_mode     = input.string("Sweep (fakeout wick) only", "Level type", options = ["Swing or Sweep", "Sweep (fakeout wick) only"], group = G_SETUP,
     tooltip = "Sweep only = the swing must have taken out a prior swing high/low and rejected (true fakeout wick). Fewer but cleaner zones.")

zone_sizing_mode = input.string(MODE_LOCAL, "Zone sizing mode", options = [MODE_LOCAL, MODE_DAILY], group = G_ZONE)
atr_len          = input.int(14, "ATR length", minval = 1, group = G_ZONE)
min_zone_atr     = input.float(0.15, "Min zone height (× ATR)", minval = 0.0, step = 0.05, group = G_ZONE)
max_zone_atr     = input.float(1.00, "Max zone height (× ATR)", minval = 0.05, step = 0.05, group = G_ZONE)

max_break_bars   = input.int(5, "Max bars to break the Mother Bar", minval = 1, group = G_BREAK)
min_impulse_mult = input.float(0.5, "Min impulse away from zone (× zone height)", minval = 0.0, step = 0.25, group = G_BREAK)
max_impulse_bars = input.int(5, "Max bars for the impulse after the break", minval = 1, group = G_BREAK)

confirm_mode   = input.string("Rejection Wick %", "Confirmation filter",
     options = ["None", "Candle Color", "Rejection Wick %", "Color + Wick"], group = G_RET)
rej_wick_pct   = input.float(0.45, "Rejection wick ≥ % of candle range", minval = 0.0, maxval = 1.0, step = 0.05, group = G_RET)
confirm_close_outside = input.bool(true, "Rejection candle must close OUTSIDE the box", group = G_RET,
     tooltip = "ON: close beyond the inner edge of the box (full rejection). OFF: a close back inside the box is enough.")
allow_deep_sweep = input.bool(true, "Allow deep sweep through the box (classic fakeout)", group = G_RET,
     tooltip = "ON: the retest wick may spike THROUGH the box as long as the candle closes back on the right side. SL goes beyond that wick. OFF: the wick must stay within SL buffer of the outer edge.")
confirm_window = input.int(3, "Confirmation window after first touch (bars)", minval = 1, group = G_RET,
     tooltip = "If no rejection candle appears within this many bars after the FIRST touch, the zone is consumed without a trade.")
max_zone_age   = input.int(200, "Max zone age after verification (bars)", minval = 10, group = G_RET)

G_ENTRY = "4b) Entry Execution"
ENTRY_MARKET = "Market @ confirmation close"
ENTRY_LIMIT  = "Limit pullback (% of confirmation candle)"
entry_mode       = input.string(ENTRY_LIMIT, "Entry mode", options = [ENTRY_MARKET, ENTRY_LIMIT], group = G_ENTRY,
     tooltip = "Limit pullback: after the rejection candle closes, a limit order waits at a retracement into that candle. Smaller risk → same price move = more R. Unfilled orders are cancelled.")
limit_pct        = input.float(50.0, "Limit level (% of confirmation candle, from the wick extreme)", minval = 10.0, maxval = 90.0, step = 5.0, group = G_ENTRY)
entry_valid_bars = input.int(3, "Limit order valid for N bars", minval = 1, group = G_ENTRY)

sl_buffer_mode  = input.string("Ticks", "SL buffer mode", options = ["Ticks", "ATR"], group = G_RISK)
sl_buffer_ticks = input.int(10, "SL buffer (ticks)", minval = 0, group = G_RISK)
sl_buffer_atr   = input.float(0.10, "SL buffer (× ATR)", minval = 0.0, step = 0.05, group = G_RISK)
tp1_rr          = input.float(2.0, "TP1 Risk:Reward (1:2 BOOK)", minval = 0.5, maxval = 5.0, step = 0.25, group = G_RISK)
tp1_qty_pct     = input.float(50.0, "TP1 quantity (% of position)", minval = 1.0, maxval = 99.0, step = 5.0, group = G_RISK)
tp2_rr          = input.float(3.0, "TP2 Risk:Reward (FINAL)", minval = 1.0, maxval = 5.0, step = 0.25, group = G_RISK)
move_to_be      = input.bool(true, "Move SL to breakeven after TP1", group = G_RISK)
be_lock_r       = input.float(0.0, "Lock profit after TP1 (R multiple, 0 = pure breakeven)", minval = 0.0, maxval = 2.0, step = 0.25, group = G_RISK)
time_stop_bars  = input.int(12, "Time stop: close if TP1 not hit within N bars after fill (0 = off)", minval = 0, group = G_RISK)
min_risk_atr    = input.float(0.30, "Min risk per trade (× ATR)", minval = 0.0, step = 0.05, group = G_RISK,
     tooltip = "Skip setups whose stop is thinner than this. Razor-thin stops get hit by spread / noise.")
max_risk_atr    = input.float(2.00, "Max risk per trade (× ATR)", minval = 0.1, step = 0.1, group = G_RISK)

G_SIZE = "5b) Position Sizing"
qty_mode   = input.string("Fixed lots", "Position sizing", options = ["Fixed lots", "Risk % of Equity", "Strategy Default (Properties tab)"], group = G_SIZE)
fixed_lots = input.float(0.1, "Fixed lots per trade", minval = 0.01, step = 0.01, group = G_SIZE)
oz_per_lot = input.float(100.0, "Units (oz) per lot", minval = 1.0, step = 1.0, group = G_SIZE,
     tooltip = "Standard gold lot = 100 oz. TradingView quantity for OANDA XAUUSD is in oz, so 0.1 lot = 10. Backtest on $1000: 0.1 lot averaged $65 risk per trade (6.5%) with a $593 max drawdown. 0.03 lot keeps risk near 2%.")
risk_pct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.05, maxval = 10.0, step = 0.25, group = G_SIZE,
     tooltip = "Quantity = equity × risk% ÷ (entry-to-SL distance × point value). 1% risk = 1R ≈ 1% of equity.")
max_leverage = input.float(10.0, "Max leverage (caps quantity)", minval = 1.0, maxval = 50.0, step = 1.0, group = G_SIZE,
     tooltip = "Quantity is capped so notional ≤ equity × leverage. Keep this well below the margin limit (1% margin = 100×) so the broker emulator never issues a margin call: at 10× only 10% of equity is tied up as margin.")

trade_dir_mode = input.string("Both", "Trade direction", options = ["Both", "Long Only", "Short Only"], group = G_FILT)
use_trend      = input.bool(false, "Trend filter (EMA bias)", group = G_FILT,
     tooltip = "Longs only above the EMA, shorts only below it.")
trend_len      = input.int(200, "Trend EMA length", minval = 5, group = G_FILT)
trend_tf       = input.timeframe("15", "Trend EMA timeframe", group = G_FILT)
max_ema_dist_atr = input.float(0.0, "Max distance from trend EMA (× ATR, 0 = off)", minval = 0.0, step = 0.5, group = G_FILT,
     tooltip = "Skip entries when price is over-extended from the EMA (snap-back risk).")
max_trades_day = input.int(1, "Max trades per day (0 = unlimited)", minval = 0, group = G_FILT)
use_session    = input.bool(true, "Use session filter", group = G_FILT)
session_str    = input.session("0300-1600", "Session (London open → NY close)", group = G_FILT)
session_tz     = input.string("America/New_York", "Session timezone", group = G_FILT)
max_zones      = input.int(50, "Max stored zones", minval = 5, maxval = 100, group = G_FILT)

show_zone_boxes = input.bool(true, "Show Support / Resistance boxes", group = G_VIS)
show_markers    = input.bool(true, "Show IB / BREAK markers", group = G_VIS)
show_measure    = input.bool(true, "Show zone measurement label", group = G_VIS)
show_trade_viz  = input.bool(true, "Show trade RR projections", group = G_VIS)
proj_bars       = input.int(20, "Projection width (bars)", minval = 3, group = G_VIS)
max_trade_viz   = input.int(40, "Max stored trade projections", minval = 5, maxval = 150, group = G_VIS)

show_dash = input.bool(true, "Show checklist dashboard", group = G_DASH)
show_diag = input.bool(true, "Show filter diagnostics table", group = G_DASH)
diag_pos  = input.string("Bottom Right", "Diagnostics position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = G_DASH)
dash_pos  = input.string("Top Left", "Dashboard position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = G_DASH)
dash_size = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal"], group = G_DASH)

// =============================================================================
//  USER-DEFINED TYPES
// =============================================================================
type Zone
    int   id
    int   kind
    int   state
    float top
    float bottom
    float mother_high
    float mother_low
    float wick_size
    int   swing_bar
    int   ib_bar
    int   break_bar     = -1
    int   verified_bar  = -1
    int   retest_bar    = -1
    int   end_bar       = -1
    float level_price   = na
    float ib_price      = na
    float break_price   = na
    float impulse_price = na
    float retest_price  = na
    float retest_extreme = na
    float confirm_price = na
    float entry_price   = na
    float sl_price      = na
    float tp1_price     = na
    float tp2_price     = na
    bool  tp1_hit       = false
    bool  tp2_hit       = false
    bool  stopped       = false
    bool  is_used       = false
    box   bx            = na
    label measure_lbl   = na

type TradeViz
    box   tp_box
    box   sl_box
    line  tp1_line
    label tp1_lbl
    label info_lbl

// =============================================================================
//  ZONE METHODS
// =============================================================================
method height(Zone z) =>
    z.top - z.bottom

method isSupport(Zone z) =>
    z.kind == KIND_SUPPORT

method labelText(Zone z) =>
    z.isSupport() ? "support" : "resistance"

method isAlive(Zone z) =>
    z.state == ST_PENDING or z.state == ST_BROKEN or z.state == ST_VERIFIED

method overlaps(Zone z, float t, float b) =>
    b <= z.top and t >= z.bottom

method deleteDrawings(Zone z) =>
    if not na(z.bx)
        box.delete(z.bx)
        z.bx := na
    if not na(z.measure_lbl)
        label.delete(z.measure_lbl)
        z.measure_lbl := na

method drawBox(Zone z) =>
    if na(z.bx)
        z.bx := box.new(z.swing_bar, z.top, bar_index, z.bottom,
             border_color = color.yellow, border_width = 2,
             bgcolor = color.new(color.maroon, 35),
             text = z.labelText(), text_color = color.white, text_size = size.small,
             text_halign = text.align_center, text_valign = text.align_center)

method extendBox(Zone z) =>
    if not na(z.bx)
        box.set_right(z.bx, bar_index)

method drawMeasure(Zone z) =>
    if na(z.measure_lbl)
        float h    = z.height()
        float sign = z.isSupport() ? 1.0 : -1.0
        float ref  = z.isSupport() ? z.bottom : z.top
        float pct  = ref != 0 ? sign * h / ref * 100.0 : 0.0
        string txt = str.tostring(sign * h, format.mintick) +
                     " (" + str.tostring(pct, "#.##") + "%) " +
                     str.tostring(sign * h / syminfo.mintick, "#") +
                     " | " + str.tostring(bar_index - z.swing_bar) + " bars"
        z.measure_lbl := label.new(bar_index, z.isSupport() ? z.bottom : z.top, txt,
             style = z.isSupport() ? label.style_label_up : label.style_label_down,
             color = color.new(color.black, 20), textcolor = color.white, size = size.small)

method verify(Zone z, bool draw_box, bool draw_measure) =>
    z.state         := ST_VERIFIED
    z.verified_bar  := bar_index
    z.impulse_price := z.isSupport() ? high : low
    if draw_box
        z.drawBox()
    if draw_measure
        z.drawMeasure()

method finish(Zone z, int new_state, color border) =>
    z.state   := new_state
    z.end_bar := bar_index
    if not na(z.bx)
        box.set_right(z.bx, bar_index)
        box.set_border_color(z.bx, border)

// =============================================================================
//  STATE
// =============================================================================
var array<Zone>     zones      = array.new<Zone>()
var array<TradeViz> trade_vizs = array.new<TradeViz>()
var int   next_zone_id   = 0
var float daily_ref_wick = na
var Zone  focus          = na       // zone shown on the dashboard
var Zone  trade_zone     = na       // zone of the open trade

var int   trade_dir   = 0           // 1 long, -1 short, 0 flat
var int   t_entry_bar = -1          // bar the order was placed
var int   t_fill_bar  = -1          // bar the order filled (market: same bar)
var bool  t_pending   = false       // order placed, not filled yet
var float t_entry     = na
var float t_sl        = na
var float t_cur_sl    = na
var float t_tp1       = na
var float t_tp2       = na
var bool  t_tp1_hit   = false
var int   trades_today = 0
var int   cnt_cand      = 0
var int   cnt_verified  = 0
var int   cnt_confirmed = 0
var int   cnt_trades    = 0
var int   blk_intrade   = 0
var int   blk_session   = 0
var int   blk_direction = 0
var int   blk_trend     = 0
var int   blk_extended  = 0
var int   blk_daycap    = 0
var int   blk_risk      = 0
var int   blk_unfilled  = 0

// =============================================================================
//  SERIES CALCULATIONS (global scope)
// =============================================================================
tick      = syminfo.mintick
atr       = ta.atr(atr_len)
use_daily = zone_sizing_mode == MODE_DAILY
new_day   = timeframe.change("D")

candle_range   = high - low
upper_wick     = high - math.max(open, close)
lower_wick     = math.min(open, close) - low
upper_wick_pct = candle_range > 0 ? upper_wick / candle_range : 0.0
lower_wick_pct = candle_range > 0 ? lower_wick / candle_range : 0.0

ib_tol         = ib_tol_ticks * tick + ib_tol_atr * nz(atr)
enough_history = bar_index > swing_lookback + ctx_bars + 2
is_inside_bar  = enough_history and high <= high[1] + ib_tol and low >= low[1] - ib_tol
ib_color_res   = ib_color_mode == "Any Color" or close < open
ib_color_sup   = ib_color_mode == "Any Color" or close > open

prior_hi = ta.highest(high, swing_lookback)[1]   // highest high of the lookback BEFORE this bar
prior_lo = ta.lowest(low, swing_lookback)[1]
ctx_hi   = ta.highest(high, ctx_bars)[1]         // highest high of the context window (bars 1..ctx_bars)
ctx_lo   = ta.lowest(low, ctx_bars)[1]

is_local_swing_high = ctx_hi >= prior_hi
is_local_swing_low  = ctx_lo <= prior_lo

bar_sweeps_high = high > prior_hi and close < prior_hi and upper_wick_pct >= sweep_wick_pct
bar_sweeps_low  = low  < prior_lo and close > prior_lo and lower_wick_pct >= sweep_wick_pct
sweep_high_ctx  = math.sum(bar_sweeps_high ? 1 : 0, ctx_bars)[1] > 0
sweep_low_ctx   = math.sum(bar_sweeps_low  ? 1 : 0, ctx_bars)[1] > 0

sweep_only    = level_mode == "Sweep (fakeout wick) only"
res_context   = sweep_only ? sweep_high_ctx : (is_local_swing_high or sweep_high_ctx)
sup_context   = sweep_only ? sweep_low_ctx  : (is_local_swing_low  or sweep_low_ctx)
res_candidate = is_inside_bar and ib_color_res and res_context
sup_candidate = is_inside_bar and ib_color_sup and sup_context

sl_buffer  = sl_buffer_mode == "Ticks" ? sl_buffer_ticks * tick : sl_buffer_atr * atr
trend_ema  = request.security(syminfo.tickerid, trend_tf, ta.ema(close, trend_len), lookahead = barmerge.lookahead_off)
trend_long_ok  = not use_trend or close > trend_ema
trend_short_ok = not use_trend or close < trend_ema
in_session = not use_session or not na(time(timeframe.period, session_str, session_tz))
can_long   = trade_dir_mode != "Short Only"
can_short  = trade_dir_mode != "Long Only"

// =============================================================================
//  HELPER FUNCTIONS
// =============================================================================
px(float p) =>
    str.tostring(p, format.mintick)

f_clamp_height(float raw_h, float atr_v) =>
    float lo = math.max(min_zone_atr * atr_v, tick)
    float hi = math.max(max_zone_atr * atr_v, lo)
    math.min(hi, math.max(lo, nz(raw_h, lo)))

// Offset (1..ctx_bars) of the swing / fakeout bar inside the context window.
f_swing_offset(bool for_high) =>
    int off = 1
    for k = 1 to ctx_bars
        bool hit = for_high ? high[k] == ctx_hi : low[k] == ctx_lo
        if hit
            off := k
            break
    off

// Zone bounds for a new candidate (local mode, or locked daily height when available).
f_zone_bounds(int kind, float atr_v) =>
    float top = na
    float bottom = na
    if kind == KIND_RESISTANCE
        top := math.max(ctx_hi, high)
        float raw_h = top - math.min(math.max(open[1], close[1]), low)
        float h = use_daily and not na(daily_ref_wick) ? daily_ref_wick : f_clamp_height(raw_h, atr_v)
        bottom := top - h
    else
        bottom := math.min(ctx_lo, low)
        float raw_h = math.max(math.min(open[1], close[1]), high) - bottom
        float h = use_daily and not na(daily_ref_wick) ? daily_ref_wick : f_clamp_height(raw_h, atr_v)
        top := bottom + h
    [top, bottom]

f_confirm_ok(bool is_long) =>
    bool color_ok = is_long ? close > open : close < open
    bool wick_ok  = is_long ? lower_wick_pct >= rej_wick_pct : upper_wick_pct >= rej_wick_pct
    switch confirm_mode
        "None"             => true
        "Candle Color"     => color_ok
        "Rejection Wick %" => wick_ok
        => color_ok and wick_ok

f_add_trade_viz(bool is_long, float entry, float sl, float tp1, float tp2) =>
    int x1 = bar_index
    int x2 = bar_index + proj_bars
    box tpb = box.new(x1, math.max(entry, tp2), x2, math.min(entry, tp2),
         border_color = color.new(color.green, 40), border_width = 1,
         bgcolor = color.new(color.green, 80),
         text = "TP2  1:" + str.tostring(tp2_rr, "#.##") + " FINAL",
         text_color = color.new(color.white, 20), text_size = size.tiny,
         text_halign = text.align_right, text_valign = is_long ? text.align_top : text.align_bottom)
    box slb = box.new(x1, math.max(entry, sl), x2, math.min(entry, sl),
         border_color = color.new(color.red, 40), border_width = 1,
         bgcolor = color.new(color.red, 80),
         text = "SL", text_color = color.new(color.white, 20), text_size = size.tiny,
         text_halign = text.align_right, text_valign = is_long ? text.align_bottom : text.align_top)
    line tl = line.new(x1, tp1, x2, tp1, color = color.yellow, style = line.style_dashed, width = 1)
    label tlb = label.new(x2, tp1, "1:" + str.tostring(tp1_rr, "#.##") + " BOOK",
         style = label.style_label_left, color = color.new(color.yellow, 0),
         textcolor = color.black, size = size.small)
    float risk = math.abs(entry - sl)
    string info = (is_long ? "LONG" : "SHORT") + " @ " + px(entry) +
                  "\nSL " + px(sl) + "  (risk " + px(risk) + ")" +
                  "\nTP1 " + px(tp1) + " | TP2 " + px(tp2)
    label ilb = label.new(x1, sl, info,
         style = is_long ? label.style_label_up : label.style_label_down,
         color = color.new(color.black, 20), textcolor = color.white, size = size.small)
    array.push(trade_vizs, TradeViz.new(tpb, slb, tl, tlb, ilb))
    if array.size(trade_vizs) > max_trade_viz
        TradeViz old = array.shift(trade_vizs)
        box.delete(old.tp_box)
        box.delete(old.sl_box)
        line.delete(old.tp1_line)
        label.delete(old.tp1_lbl)
        label.delete(old.info_lbl)

// =============================================================================
//  DAILY RESET (Daily Reference Wick mode)
// =============================================================================
if new_day
    trades_today := 0
    if use_daily
        daily_ref_wick := na

// =============================================================================
//  TRADE STATE RESET (position closed on a previous bar)
// =============================================================================
bool reset_trade = false
if trade_dir != 0 and bar_index > t_entry_bar
    if t_pending
        if strategy.position_size != 0
            t_pending  := false                       // filled during the previous bar
            t_fill_bar := bar_index - 1
        else if bar_index - t_entry_bar > (entry_mode == ENTRY_MARKET ? 0 : entry_valid_bars)
            strategy.cancel(trade_dir == 1 ? "Long" : "Short")
            if not na(trade_zone)
                trade_zone.entry_price := na
                trade_zone.sl_price    := na
                trade_zone.tp1_price   := na
                trade_zone.tp2_price   := na
                trade_zone.finish(ST_CONSUMED, color.gray)
            blk_unfilled += 1
            reset_trade  := true
    else if strategy.position_size == 0
        reset_trade := true                           // position closed on a previous bar
if reset_trade
    trade_dir  := 0
    trade_zone := na
    t_pending  := false
    t_entry    := na
    t_sl       := na
    t_cur_sl   := na
    t_tp1      := na
    t_tp2      := na
    t_tp1_hit  := false

// =============================================================================
//  ZONE STATE MACHINE
// =============================================================================
bool long_sig        = false
bool short_sig       = false
Zone sig_zone        = na
bool break_up_marker = false
bool break_dn_marker = false

if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        bool remove = false

        // ------------------------------------------------------------------ PENDING_BREAK
        if z.state == ST_PENDING
            if z.isSupport()
                if close < z.bottom
                    remove := true                                   // broke the wrong way
                else if close > z.mother_high
                    z.state       := ST_BROKEN
                    z.break_bar   := bar_index
                    z.break_price := close
                    break_up_marker := true
                else if bar_index - z.ib_bar > max_break_bars
                    remove := true                                   // no break in time
            else
                if close > z.top
                    remove := true
                else if close < z.mother_low
                    z.state       := ST_BROKEN
                    z.break_bar   := bar_index
                    z.break_price := close
                    break_dn_marker := true
                else if bar_index - z.ib_bar > max_break_bars
                    remove := true

        // ------------------------------------------------------------------ BROKEN → impulse away
        else if z.state == ST_BROKEN
            float need = min_impulse_mult * z.height()
            bool impulse_done = z.isSupport() ? high >= z.top + need : low <= z.bottom - need
            bool wrong_way    = z.isSupport() ? close < z.bottom : close > z.top
            if wrong_way
                remove := true
            else if impulse_done
                // Daily Reference Wick mode: lock the height on the first verified setup of the day
                if use_daily and na(daily_ref_wick)
                    daily_ref_wick := f_clamp_height(z.wick_size, atr)
                    if z.isSupport()
                        z.top := z.bottom + daily_ref_wick
                    else
                        z.bottom := z.top - daily_ref_wick
                z.verify(show_zone_boxes, show_measure)
                cnt_verified += 1
            else if bar_index - z.break_bar > max_impulse_bars
                remove := true

        // ------------------------------------------------------------------ VERIFIED_ACTIVE → first retest
        else if z.state == ST_VERIFIED
            z.extendBox()
            bool invalid = z.isSupport() ? close < z.bottom : close > z.top
            if invalid
                z.finish(ST_INVALIDATED, color.gray)
            else if bar_index - z.verified_bar > max_zone_age
                z.finish(ST_EXPIRED, color.gray)
            else
                bool touched = z.isSupport() ?
                     (low  <= z.top    and (allow_deep_sweep or low  >= z.bottom - sl_buffer)) :
                     (high >= z.bottom and (allow_deep_sweep or high <= z.top    + sl_buffer))
                if touched and z.retest_bar < 0
                    z.retest_bar   := bar_index
                    z.retest_price := z.isSupport() ? low : high
                if touched
                    z.retest_extreme := z.isSupport() ?
                         math.min(nz(z.retest_extreme, low),  low) :
                         math.max(nz(z.retest_extreme, high), high)
                if z.retest_bar >= 0
                    bool close_ok = z.isSupport() ?
                         (confirm_close_outside ? close > z.top    : close > z.bottom) :
                         (confirm_close_outside ? close < z.bottom : close < z.top)
                    bool confirmed = touched and close_ok and f_confirm_ok(z.isSupport())
                    if confirmed and na(sig_zone)
                        cnt_confirmed   += 1
                        z.confirm_price := close
                        z.is_used       := true
                        sig_zone        := z
                        if z.isSupport()
                            long_sig := true
                        else
                            short_sig := true
                    else if not confirmed and bar_index - z.retest_bar >= confirm_window
                        z.is_used := true
                        z.finish(ST_CONSUMED, color.gray)

        if remove
            z.deleteDrawings()
            array.remove(zones, i)

// =============================================================================
//  NEW CANDIDATE ZONE (Steps 1 & 2)
// =============================================================================
bool ib_marker_res = false
bool ib_marker_sup = false
int  cand_kind     = 0
if res_candidate and sup_candidate
    cand_kind := close[1] < open[1] ? KIND_RESISTANCE : KIND_SUPPORT
else if res_candidate
    cand_kind := KIND_RESISTANCE
else if sup_candidate
    cand_kind := KIND_SUPPORT

if cand_kind != 0 and not na(atr) and atr > 0
    [z_top, z_bot] = f_zone_bounds(cand_kind, atr)
    bool dup = false
    for ze in zones
        if ze.kind == cand_kind and ze.isAlive() and ze.overlaps(z_top, z_bot)
            dup := true
            break
    if not dup and z_top > z_bot
        int   off  = f_swing_offset(cand_kind == KIND_RESISTANCE)
        float wick = cand_kind == KIND_RESISTANCE ?
             high[off] - math.max(open[off], close[off]) :
             math.min(open[off], close[off]) - low[off]
        Zone zc = Zone.new(
             id          = next_zone_id,
             kind        = cand_kind,
             state       = ST_PENDING,
             top         = z_top,
             bottom      = z_bot,
             mother_high = high[1],
             mother_low  = low[1],
             wick_size   = wick,
             swing_bar   = bar_index - off,
             ib_bar      = bar_index)
        zc.level_price := cand_kind == KIND_RESISTANCE ? z_top : z_bot
        zc.ib_price    := close
        next_zone_id   += 1
        cnt_cand       += 1
        array.push(zones, zc)
        if array.size(zones) > max_zones
            Zone old = array.shift(zones)
            old.deleteDrawings()
        if trade_dir == 0
            focus := zc
        ib_marker_res := cand_kind == KIND_RESISTANCE
        ib_marker_sup := cand_kind == KIND_SUPPORT

// =============================================================================
//  ENTRY (Step 6) – ONE trade per zone
// =============================================================================
if not na(sig_zone)
    Zone zt = sig_zone
    bool is_long = long_sig
    bool f_flat     = trade_dir == 0 and strategy.position_size == 0
    bool f_dir      = is_long ? can_long : can_short
    bool f_trend    = is_long ? trend_long_ok : trend_short_ok
    bool f_extended = max_ema_dist_atr == 0 or math.abs(close - trend_ema) <= max_ema_dist_atr * atr
    bool f_cap      = max_trades_day == 0 or trades_today < max_trades_day
    bool allowed    = f_flat and in_session and f_dir and f_trend and f_extended and f_cap
    if not allowed
        if not f_flat
            blk_intrade += 1
        else if not in_session
            blk_session += 1
        else if not f_dir
            blk_direction += 1
        else if not f_trend
            blk_trend += 1
        else if not f_extended
            blk_extended += 1
        else
            blk_daycap += 1
    bool taken   = false
    if allowed
        // SL just beyond the fakeout wick: the outer box edge or the retest wick extreme, whichever is further
        float sl    = is_long ?
             math.min(zt.bottom, nz(zt.retest_extreme, zt.bottom)) - sl_buffer :
             math.max(zt.top,    nz(zt.retest_extreme, zt.top))    + sl_buffer
        // Entry: market at close, or a limit pullback into the confirmation candle
        float entry = close
        if entry_mode == ENTRY_LIMIT
            float f   = limit_pct / 100.0
            float lim = is_long ? low + f * (high - low) : high - f * (high - low)
            entry := is_long ? math.min(lim, close) : math.max(lim, close)
        float risk  = math.abs(entry - sl)
        bool risk_ok = risk >= tick and risk >= min_risk_atr * atr and risk <= max_risk_atr * atr
        if not risk_ok
            blk_risk += 1
        if risk_ok
            float tp1 = is_long ? entry + risk * tp1_rr : entry - risk * tp1_rr
            float tp2 = is_long ? entry + risk * tp2_rr : entry - risk * tp2_rr
            zt.entry_price := entry
            zt.sl_price    := sl
            zt.tp1_price   := tp1
            zt.tp2_price   := tp2
            zt.finish(ST_TRADED, color.lime)
            trade_zone  := zt
            trade_dir   := is_long ? 1 : -1
            t_entry_bar := bar_index
            t_fill_bar  := bar_index
            t_pending   := true
            t_entry     := entry
            t_sl        := sl
            t_cur_sl    := sl
            t_tp1       := tp1
            t_tp2       := tp2
            t_tp1_hit   := false
            focus       := zt
            taken       := true
            trades_today += 1
            cnt_trades   += 1
            float qty = na
            if qty_mode == "Fixed lots"
                qty := fixed_lots * oz_per_lot
            else if qty_mode == "Risk % of Equity"
                float qty_risk = strategy.equity * risk_pct / 100.0 / (risk * syminfo.pointvalue)
                float qty_lev  = strategy.equity * max_leverage / (entry * syminfo.pointvalue)
                qty := math.max(math.min(qty_risk, qty_lev), syminfo.mintick)
            float lim_px = entry_mode == ENTRY_LIMIT ? entry : na
            if is_long
                strategy.entry("Long", strategy.long, qty = qty, limit = lim_px, comment = "Long @ " + zt.labelText())
            else
                strategy.entry("Short", strategy.short, qty = qty, limit = lim_px, comment = "Short @ " + zt.labelText())
            if show_trade_viz
                f_add_trade_viz(is_long, entry, sl, tp1, tp2)
            alert((is_long ? "LONG" : "SHORT") + " " + syminfo.ticker + (entry_mode == ENTRY_LIMIT ? " LIMIT @ " : " @ ") + px(entry) +
                 " | SL " + px(sl) + " | TP1 " + px(tp1) + " | TP2 " + px(tp2), alert.freq_once_per_bar_close)
    if not taken
        zt.finish(ST_CONSUMED, color.gray)

// =============================================================================
//  EXITS (Steps 7 & 8) – SL / 1:2 BOOK / 1:3 FINAL / breakeven
// =============================================================================
if trade_dir == 1
    bool after_entry = not t_pending and bar_index > t_fill_bar
    if after_entry and not t_tp1_hit and high >= t_tp1
        t_tp1_hit := true
        if not na(trade_zone)
            trade_zone.tp1_hit := true
        if move_to_be
            t_cur_sl := t_entry + be_lock_r * (t_entry - t_sl)
    if time_stop_bars > 0 and after_entry and not t_tp1_hit and bar_index - t_fill_bar >= time_stop_bars
        strategy.close("Long", comment = "Time stop")
    if after_entry and high >= t_tp2 and not na(trade_zone)
        trade_zone.tp2_hit := true
    if after_entry and low <= t_cur_sl and not na(trade_zone)
        trade_zone.stopped := true
    if not t_tp1_hit
        strategy.exit("Long TP1", from_entry = "Long", qty_percent = tp1_qty_pct, limit = t_tp1, stop = t_sl, comment = "1:2 BOOK / SL")
    strategy.exit("Long TP2", from_entry = "Long", limit = t_tp2, stop = t_cur_sl, comment = "1:3 FINAL / SL")

if trade_dir == -1
    bool after_entry = not t_pending and bar_index > t_fill_bar
    if after_entry and not t_tp1_hit and low <= t_tp1
        t_tp1_hit := true
        if not na(trade_zone)
            trade_zone.tp1_hit := true
        if move_to_be
            t_cur_sl := t_entry - be_lock_r * (t_sl - t_entry)
    if time_stop_bars > 0 and after_entry and not t_tp1_hit and bar_index - t_fill_bar >= time_stop_bars
        strategy.close("Short", comment = "Time stop")
    if after_entry and low <= t_tp2 and not na(trade_zone)
        trade_zone.tp2_hit := true
    if after_entry and high >= t_cur_sl and not na(trade_zone)
        trade_zone.stopped := true
    if not t_tp1_hit
        strategy.exit("Short TP1", from_entry = "Short", qty_percent = tp1_qty_pct, limit = t_tp1, stop = t_sl, comment = "1:2 BOOK / SL")
    strategy.exit("Short TP2", from_entry = "Short", limit = t_tp2, stop = t_cur_sl, comment = "1:3 FINAL / SL")

// =============================================================================
//  PLOTS & MARKERS
// =============================================================================
plotshape(show_markers and ib_marker_res, "Inside Bar (Resistance)", shape.circle, location.abovebar,
     color.new(color.yellow, 25), text = "IB", textcolor = color.yellow, size = size.tiny)
plotshape(show_markers and ib_marker_sup, "Inside Bar (Support)", shape.circle, location.belowbar,
     color.new(color.yellow, 25), text = "IB", textcolor = color.yellow, size = size.tiny)
plotshape(show_markers and break_up_marker, "Break Up", shape.triangleup, location.belowbar,
     color.new(color.aqua, 0), text = "BREAK", textcolor = color.aqua, size = size.tiny)
plotshape(show_markers and break_dn_marker, "Break Down", shape.triangledown, location.abovebar,
     color.new(color.orange, 0), text = "BREAK", textcolor = color.orange, size = size.tiny)

plot(use_trend ? trend_ema : na, "Trend EMA", color.new(color.blue, 40), 1)
plot(trade_dir != 0 ? t_cur_sl : na, "Active Stop Loss", color.new(color.red, 0), 1, plot.style_linebr)
plot(trade_dir != 0 and not t_tp1_hit ? t_tp1 : na, "Active TP1", color.new(color.yellow, 0), 1, plot.style_linebr)
plot(trade_dir != 0 ? t_tp2 : na, "Active TP2", color.new(color.lime, 0), 1, plot.style_linebr)

// =============================================================================
//  8-STEP CHECKLIST DASHBOARD
// =============================================================================
f_dash_pos(string s) =>
    switch s
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

f_dash_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

C_BG      = color.new(#0b0f1a, 5)
C_HEAD    = color.new(#1a2236, 0)
C_ROW     = color.new(#121826, 0)
C_PASS    = color.new(#4ade80, 0)
C_WAIT    = color.new(#9ca3af, 0)
C_ACTIVE  = color.new(#facc15, 0)
C_FAIL    = color.new(#f87171, 0)
C_DONE    = color.new(#60a5fa, 0)
WAITING   = "⚪ Waiting"

var table dash = table.new(f_dash_pos(dash_pos), 2, 9, bgcolor = C_BG,
     border_color = color.new(color.gray, 70), border_width = 1,
     frame_color = color.new(color.yellow, 40), frame_width = 1)

f_cell(int row, string step, string status, color status_col) =>
    table.cell(dash, 0, row, step, text_color = color.white, text_size = f_dash_size(dash_size), bgcolor = C_ROW, text_halign = text.align_left)
    table.cell(dash, 1, row, status, text_color = status_col, text_size = f_dash_size(dash_size), bgcolor = C_ROW, text_halign = text.align_left)

if show_dash and barstate.islast
    bool has = not na(focus)

    // 1 LEVEL MARK
    string s1 = WAITING
    color  c1 = C_WAIT
    if has
        s1 := "🟢 " + (focus.isSupport() ? "Support" : "Resistance") + " @ " + px(focus.level_price) +
              "  [" + px(focus.bottom) + " – " + px(focus.top) + "]"
        c1 := C_PASS

    // 2 INSIDE BAR
    string s2 = WAITING
    color  c2 = C_WAIT
    if has
        s2 := "🟢 IB close @ " + px(focus.ib_price) + "  (MB " + px(focus.mother_low) + " – " + px(focus.mother_high) + ")"
        c2 := C_PASS

    // 3 BREAK (+ impulse verification)
    string s3 = WAITING
    color  c3 = C_WAIT
    if has
        if focus.verified_bar >= 0
            s3 := "🟢 Break @ " + px(focus.break_price) + " · Verified @ " + px(focus.impulse_price)
            c3 := C_PASS
        else if focus.break_bar >= 0
            s3 := "🟡 Break @ " + px(focus.break_price) + " · waiting impulse"
            c3 := C_ACTIVE
        else if focus.state == ST_PENDING
            s3 := "🟡 Waiting break of " + (focus.isSupport() ? px(focus.mother_high) : px(focus.mother_low))
            c3 := C_ACTIVE

    // 4 RETEST
    string s4 = WAITING
    color  c4 = C_WAIT
    if has
        if focus.retest_bar >= 0
            s4 := "🟢 Retest @ " + px(focus.retest_price)
            c4 := C_PASS
        else if focus.state == ST_VERIFIED
            s4 := "🟡 Active · waiting pullback into zone"
            c4 := C_ACTIVE
        else if focus.state == ST_INVALIDATED
            s4 := "🔴 Zone invalidated"
            c4 := C_FAIL
        else if focus.state == ST_EXPIRED
            s4 := "⚫ Zone expired"
            c4 := C_WAIT

    // 5 CONFIRMATION
    string s5 = WAITING
    color  c5 = C_WAIT
    if has
        if not na(focus.confirm_price)
            s5 := "🟢 Rejection close @ " + px(focus.confirm_price)
            c5 := C_PASS
        else if focus.state == ST_CONSUMED
            s5 := "🔴 No rejection in window · zone consumed"
            c5 := C_FAIL
        else if focus.retest_bar >= 0 and focus.state == ST_VERIFIED
            s5 := "🟡 Waiting rejection candle"
            c5 := C_ACTIVE

    // 6 ENTRY
    string s6 = WAITING
    color  c6 = C_WAIT
    if has
        if not na(focus.entry_price)
            bool is_this = trade_dir != 0 and not na(trade_zone) and trade_zone.id == focus.id
            s6 := (is_this and t_pending ? "🟡 LIMIT " : "🟢 ") + (focus.isSupport() ? "LONG" : "SHORT") + " @ " + px(focus.entry_price) +
                  (is_this ? (t_pending ? " · WAITING FILL" : " · OPEN") : " · CLOSED")
            c6 := is_this and t_pending ? C_ACTIVE : C_PASS
        else if focus.state == ST_CONSUMED and not na(focus.confirm_price)
            s6 := "⚫ Skipped (filter or limit not filled) · zone used"
            c6 := C_WAIT

    // 7 SMALL SL
    string s7 = WAITING
    color  c7 = C_WAIT
    if has and not na(focus.sl_price)
        float risk = math.abs(focus.entry_price - focus.sl_price)
        if focus.stopped
            s7 := "🔴 Stopped @ " + px(focus.sl_price) + " (risk " + px(risk) + ")"
            c7 := C_FAIL
        else
            s7 := "🟢 SL @ " + px(focus.sl_price) + " (risk " + px(risk) + ")" +
                  (focus.tp1_hit and move_to_be ? " · BE @ " + px(focus.entry_price) : "")
            c7 := C_PASS

    // 8 1:2 BOOK / 1:3 FINAL
    string s8 = WAITING
    color  c8 = C_WAIT
    if has and not na(focus.tp1_price)
        if focus.tp2_hit
            s8 := "🟢 1:2 BOOKED @ " + px(focus.tp1_price) + " · 1:3 FINAL @ " + px(focus.tp2_price)
            c8 := C_DONE
        else if focus.tp1_hit
            s8 := "🟢 1:2 BOOKED @ " + px(focus.tp1_price) + " · 🟡 1:3 @ " + px(focus.tp2_price)
            c8 := C_PASS
        else
            s8 := "🟡 TP1 @ " + px(focus.tp1_price) + " · TP2 @ " + px(focus.tp2_price)
            c8 := C_ACTIVE

    table.cell(dash, 0, 0, "GOLD SECRET · IB & FAKEOUT WICK", text_color = color.yellow, text_size = f_dash_size(dash_size), bgcolor = C_HEAD, text_halign = text.align_left)
    table.cell(dash, 1, 0, has ? "Zone #" + str.tostring(focus.id) + " · " + (focus.isSupport() ? "SUPPORT" : "RESISTANCE") : "No setup yet",
         text_color = color.yellow, text_size = f_dash_size(dash_size), bgcolor = C_HEAD, text_halign = text.align_right)
    f_cell(1, "🔥 LEVEL MARK",              s1, c1)
    f_cell(2, "📊 INSIDE BAR",              s2, c2)
    f_cell(3, "⬆️⬇️ BREAK",                 s3, c3)
    f_cell(4, "🔁 RETEST",                  s4, c4)
    f_cell(5, "✅ CONFIRMATION",            s5, c5)
    f_cell(6, "🎯 ENTRY",                   s6, c6)
    f_cell(7, "🛑 SMALL SL",                s7, c7)
    f_cell(8, "💰 1:2 BOOK / 1:3 FINAL",    s8, c8)

// =============================================================================
//  FILTER DIAGNOSTICS TABLE
// =============================================================================
var table diag = table.new(f_dash_pos(diag_pos), 2, 16, bgcolor = C_BG,
     border_color = color.new(color.gray, 70), border_width = 1,
     frame_color = color.new(color.aqua, 40), frame_width = 1)

f_diag_row(int row, string k, string v, color vc) =>
    table.cell(diag, 0, row, k, text_color = color.white, text_size = size.tiny, bgcolor = C_ROW, text_halign = text.align_left)
    table.cell(diag, 1, row, v, text_color = vc, text_size = size.tiny, bgcolor = C_ROW, text_halign = text.align_right)

if show_diag and barstate.islast
    int   closed = strategy.closedtrades
    float winpct = closed > 0 ? strategy.wintrades / closed * 100.0 : 0.0
    float pf     = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float avgwin = strategy.wintrades > 0 ? strategy.grossprofit / strategy.wintrades : 0.0
    float avglos = strategy.losstrades > 0 ? strategy.grossloss / strategy.losstrades : 0.0
    table.cell(diag, 0, 0, "FILTER DIAGNOSTICS", text_color = color.aqua, text_size = size.tiny, bgcolor = C_HEAD, text_halign = text.align_left)
    table.cell(diag, 1, 0, "count", text_color = color.aqua, text_size = size.tiny, bgcolor = C_HEAD, text_halign = text.align_right)
    f_diag_row(1,  "Candidate zones (IB @ level)",   str.tostring(cnt_cand),      color.white)
    f_diag_row(2,  "Verified zones (break+impulse)", str.tostring(cnt_verified),  color.white)
    f_diag_row(3,  "Retest confirmed (signals)",     str.tostring(cnt_confirmed), color.white)
    f_diag_row(4,  "Blocked: already in trade",      str.tostring(blk_intrade),   C_WAIT)
    f_diag_row(5,  "Blocked: session",               str.tostring(blk_session),   C_WAIT)
    f_diag_row(6,  "Blocked: direction",             str.tostring(blk_direction), C_WAIT)
    f_diag_row(7,  "Blocked: trend EMA",             str.tostring(blk_trend),     C_WAIT)
    f_diag_row(8,  "Blocked: over-extended",         str.tostring(blk_extended),  C_WAIT)
    f_diag_row(9,  "Blocked: daily cap",             str.tostring(blk_daycap),    C_WAIT)
    f_diag_row(10, "Blocked: risk size (min/max)",   str.tostring(blk_risk),      C_WAIT)
    f_diag_row(11, "Limit orders not filled",        str.tostring(blk_unfilled),  C_WAIT)
    f_diag_row(12, "Orders placed",                  str.tostring(cnt_trades),    C_PASS)
    f_diag_row(13, "Closed · Win %",                 str.tostring(closed) + " · " + str.tostring(winpct, "#.#") + "%", winpct >= 35 ? C_PASS : C_FAIL)
    f_diag_row(14, "Avg win / Avg loss",             str.tostring(avgwin, "#.##") + " / " + str.tostring(avglos, "#.##"), color.white)
    f_diag_row(15, "Profit factor",                  na(pf) ? "n/a" : str.tostring(pf, "#.##"), na(pf) ? C_WAIT : pf >= 1.5 ? C_PASS : C_FAIL)
